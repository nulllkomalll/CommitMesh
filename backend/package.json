{
  "name": "commitmesh-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test:unit": "tsx tests/fingerprint.test.ts",
    "test:concurrency": "tsx tests/concurrency.test.ts",
    "check:db": "tsx scripts/check-connection.ts"
  },
  "dependencies": {
    "@google/genai": "^3.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3"
  }
}
