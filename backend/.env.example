# MongoDB Atlas connection string (replica set; mongodb+srv:// URIs are replica sets)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/commitmesh?retryWrites=true&w=majority
# SEPARATE database for tests. The DB name MUST contain "test".
MONGODB_URI_TEST=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/commitmesh_test?retryWrites=true&w=majority
PORT=4000
# Comma-separated list of allowed browser origins (Vite dev server default)
CORS_ORIGIN=http://localhost:5173
